{
  "name": "@bei-qian/dsh-workbench",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Workspace arrangement plugin for DeepSeek Harness: keeps running workspaces on top, extensible.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "workspace",
    "sidebar",
    "workbench"
  ],
  "author": "bei-qian",
  "homepage": "https://github.com/bei-qian/dsh-workbench#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bei-qian/dsh-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/bei-qian/dsh-workbench/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
